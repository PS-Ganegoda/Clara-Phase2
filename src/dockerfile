# -----------------------------
# Base image
# -----------------------------
FROM tensorflow/tensorflow:2.20.0

# -----------------------------
# Environment variables
# -----------------------------
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# -----------------------------
# Working directory
# -----------------------------
WORKDIR /src

# -----------------------------
# Copy requirements
# -----------------------------
COPY requirements.txt .

# -----------------------------
# Install dependencies
# -----------------------------
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# -----------------------------
# Download NLTK data
# -----------------------------
RUN python -m nltk.downloader punkt wordnet

# -----------------------------
# Copy app code
# -----------------------------
COPY . .

# -----------------------------
# Expose port
# -----------------------------
EXPOSE 8000

# -----------------------------
# Start FastAPI
# -----------------------------
# Use sh -c to allow the use of environment variables in the comman

# We add '.' to the PYTHONPATH so it can find the 'src' folder
CMD ["sh", "-c", "PYTHONPATH=. python3 -m uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-8000}"]