FROM python:3.11-slim

# 1. Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

# 2. Set working directory
WORKDIR /app

# 3. Install dependencies
# We install these first so they are cached by Docker
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt
RUN python -m nltk.downloader punkt wordnet

# 4. Copy ALL files from your computer into the /app folder in Docker
COPY . .

# 5. Expose the port
EXPOSE 8000

# 6. Start Uvicorn using the module path relative to PYTHONPATH
# This is the line that fixes the 'ModuleNotFoundError'
CMD ["sh", "-c", "uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-8000}"]